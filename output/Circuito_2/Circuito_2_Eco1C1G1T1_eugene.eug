PartType spacer;
PartType scar;
PartType promoter;
PartType ribozyme;
PartType rbs;
PartType cds;
PartType terminator;
PartType cassette;

promoter pTac(.SEQUENCE("AACGATCGTTGGCTGTGTTGACAATTAATCATCGGCTCGTATAATGTGTGGAATTGTGAGCGCTCACAATT"));
promoter pTet(.SEQUENCE("TACTCCACCGTTGGCTTTTTTCCCTATCAGTGATAGAGATTGACATCCCTATCAGTGATAGAGATAATGAGCAC"));
ribozyme BydvJ(.SEQUENCE("CTGAagGGTGTCTCAAGGTGCGTACCTTGACTGATGAGTCCGAAAGGACGAAACACCcctctacaaataattttgtttaa"));
rbs A1(.SEQUENCE("AATGTTCCCTAATAATCAGCAAAGAGGTTACTAG"));
cds AmtR(.SEQUENCE(""));
terminator L3S2P55(.SEQUENCE("CTCGGTACCAAAGACGAACAATAAGACGCTGAAAAGCGTCTTTTTTCGTTTTGGTCC"));
promoter pAmtR(.SEQUENCE("CTTGTCCAACCAAATGATTCGTTACCAATTGACAGTTTCTATCGATCTATAGATAATGCTAGC"));
ribozyme RiboJ57(.SEQUENCE("CTGAAGAAGTCAATTAATGTGCTTTTAATTCTGATGAGTCGGTGACGACGAAACTTCCTCTACAAATAATTTTGTTTAA"));
rbs E1(.SEQUENCE("CCCCCCGAGGAGTAGCAC"));
cds BetI(.SEQUENCE(""));
terminator L3S3P11(.SEQUENCE("CCAATTATTGAACACCCTTCGGGGTGTTTTTTTGTTTCTGGTCTACC"));
promoter pBetI(.SEQUENCE("AGCGCGGGTGAGAGGGATTCGTTACCAATTGACAATTGATTGGACGTTCAATATAATGCTAGC"));
ribozyme RiboJ51(.SEQUENCE("CTGAAGTAGTCACCGGCTGTGCTTGCCGGTCTGATGAGCCTGTGAAGGCGAAACTACCTCTACAAATAATTTTGTTTAA"));
rbs H1(.SEQUENCE("ACCCCCGAG"));
cds HlyIIR(.SEQUENCE(""));
terminator ECK120033736(.SEQUENCE("aacgcatgagAAAGCCCCCGGAAGATCACCTTCCGGGGGCTTTtttattgcgc"));
promoter pHlyIIR(.SEQUENCE("ACCAGGAATCTGAACGATTCGTTACCAATTGACATATTTAAAATTCTTGTTTAAAatgctagc"));
ribozyme RiboJ53(.SEQUENCE("CTGAAGCGGTCAACGCATGTGCTTTGCGTTCTGATGAGACAGTGATGTCGAAACCGCCTCTACAAATAATTTTGTTTAA"));
cds PhlF(.SEQUENCE(""));
terminator ECK120033737(.SEQUENCE("GGAAACACAGAAAAAAGCCCGCACCTGACAGTGCGGGCTTTTTTTTTCGACCAAAGG"));
promoter pPhlF(.SEQUENCE("CGACGTACGGTGGAATCTGATTCGTTACCAATTGACATGATACGAAACGTACCGTATCGTTAAGGT"));
rbs P3(.SEQUENCE("CTTTACGAGGGCGATCCT"));
ribozyme RiboJ60(.SEQUENCE("CTGAAGTCGTCAAGTGCTGTGCTTGCACTTCTGATGAGGCAGTGATGCCGAAACGACCTCTACAAATAATTTTGTTTAA"));
cds QacR(.SEQUENCE(""));
terminator ECK120010818(.SEQUENCE("GTCAGTTTCACCTGTTTTACGTAAAAACCCGCTTCGGCGGGTTTTTACTTTTGG"));
promoter pQacR(.SEQUENCE("GGTATGGAAGCTATACGTTACCAATTGACAGCTAGCTCAGTCCTACTTTAGTATATAGACCGTGCGATCGGTCTATA"));
rbs Q2(.SEQUENCE("GCCATGCCATTGGCTTTTGATAGAGGACAACTACTAG"));
scar F_scar(.SEQUENCE("CGCT"));
scar E_scar(.SEQUENCE("GCTT"));
scar D_scar(.SEQUENCE("AGGT"));
scar C_scar(.SEQUENCE("AATG"));
scar B_scar(.SEQUENCE("TACG"));
scar A_scar(.SEQUENCE("GGAG"));
scar Y_scar(.SEQUENCE("ATTG"));
scar X_scar(.SEQUENCE("TGTC"));
scar V_scar(.SEQUENCE("TCTG"));
scar U_scar(.SEQUENCE("GGGC"));
scar R_scar(.SEQUENCE("GTAA"));
scar Q_scar(.SEQUENCE("GAGT"));
scar P_scar(.SEQUENCE("CCTA"));
scar O_scar(.SEQUENCE("ATGC"));
scar G_scar(.SEQUENCE("ATAG"));
cassette YFP_cassette(.SEQUENCE(""));

PartType fencepost;
fencepost Loc1();
fencepost Loc2();
fencepost Loc3();

cassette E1_BetI_cassette();
Device E1_BetI(
    pTac,
    E1_BetI_cassette
);

cassette H1_HlyIIR_cassette();
Device H1_HlyIIR(
    pTet,
    H1_HlyIIR_cassette
);

cassette Q2_QacR_cassette();
Device Q2_QacR(
    pBetI,
    pTet,
    Q2_QacR_cassette
);

cassette A1_AmtR_cassette();
Device A1_AmtR(
    pTac,
    pHlyIIR,
    A1_AmtR_cassette
);

cassette P3_PhlF_cassette();
Device P3_PhlF(
    pQacR,
    pAmtR,
    P3_PhlF_cassette
);

Device YFP_reporter_3(
    pPhlF,
    YFP_cassette
);


Rule E1_BetIRule0( ON E1_BetI:
    STARTSWITH pTac AND
    ALL_FORWARD AND
    ALL_FORWARD
);

Rule H1_HlyIIRRule0( ON H1_HlyIIR:
    ALL_FORWARD AND
    ALL_FORWARD
);

Rule Q2_QacRRule0( ON Q2_QacR:
    pTet BEFORE pBetI AND
    ALL_FORWARD AND
    ALL_FORWARD
);

Rule A1_AmtRRule0( ON A1_AmtR:
    STARTSWITH pTac AND
    pTac BEFORE pHlyIIR AND
    ALL_FORWARD AND
    ALL_FORWARD
);

Rule P3_PhlFRule0( ON P3_PhlF:
    ALL_FORWARD AND
    ALL_FORWARD AND
    STARTSWITH pQacR AND
    pQacR BEFORE pAmtR
);

Rule YFP_reporter_3Rule0( ON YFP_reporter_3:
    ALL_FORWARD AND
    ALL_FORWARD AND
    STARTSWITH pPhlF
);


E1_BetI_devices = product(E1_BetI);
H1_HlyIIR_devices = product(H1_HlyIIR);
Q2_QacR_devices = product(Q2_QacR);
A1_AmtR_devices = product(A1_AmtR);
P3_PhlF_devices = product(P3_PhlF);
YFP_reporter_3_devices = product(YFP_reporter_3);

Device E1_BetIDevice();
Device H1_HlyIIRDevice();
Device Q2_QacRDevice();
Device A1_AmtRDevice();
Device P3_PhlFDevice();
Device YFP_reporter_3Device();

Device circuit();

Rule CircuitRule0( ON circuit:
    CONTAINS E1_BetI AND
    CONTAINS H1_HlyIIR AND
    CONTAINS Q2_QacR AND
    CONTAINS A1_AmtR AND
    CONTAINS P3_PhlF AND
    CONTAINS YFP_reporter_3 AND
    STARTSWITH Loc1 AND
    Loc2 NEXTTO Loc1 AND
    P3_PhlF BEFORE E1_BetI AND
    P3_PhlF BEFORE Q2_QacR AND
    P3_PhlF BEFORE H1_HlyIIR AND
    P3_PhlF BEFORE A1_AmtR AND
    E1_BetI BEFORE Q2_QacR AND
    E1_BetI BEFORE H1_HlyIIR AND
    E1_BetI BEFORE A1_AmtR AND
    Q2_QacR BEFORE H1_HlyIIR AND
    Q2_QacR BEFORE A1_AmtR AND
    H1_HlyIIR BEFORE A1_AmtR AND
    P3_PhlF AFTER Loc2 AND
    E1_BetI AFTER Loc2 AND
    Q2_QacR AFTER Loc2 AND
    H1_HlyIIR AFTER Loc2 AND
    A1_AmtR AFTER Loc2 AND
    P3_PhlF BEFORE Loc3 AND
    E1_BetI BEFORE Loc3 AND
    Q2_QacR BEFORE Loc3 AND
    H1_HlyIIR BEFORE Loc3 AND
    A1_AmtR BEFORE Loc3 AND
    ALL_FORWARD AND
    CONTAINS E1_BetI AND
    CONTAINS H1_HlyIIR AND
    CONTAINS Q2_QacR AND
    CONTAINS A1_AmtR AND
    CONTAINS P3_PhlF AND
    CONTAINS YFP_reporter_3
);
Array allResults;

for(num i1 = 0; i1 < sizeof(E1_BetI_devices); i1 = i1 + 1) {} 
for(num i2 = 0; i2 < sizeof(H1_HlyIIR_devices); i2 = i2 + 1) {} 
for(num i3 = 0; i3 < sizeof(Q2_QacR_devices); i3 = i3 + 1) {} 
for(num i4 = 0; i4 < sizeof(A1_AmtR_devices); i4 = i4 + 1) {} 
for(num i5 = 0; i5 < sizeof(P3_PhlF_devices); i5 = i5 + 1) {} 
for(num i6 = 0; i6 < sizeof(YFP_reporter_3_devices); i6 = i6 + 1) {} 

E1_BetIDevice = E1_BetI_devices[i1];
H1_HlyIIRDevice = H1_HlyIIR_devices[i2];
Q2_QacRDevice = Q2_QacR_devices[i3];
A1_AmtRDevice = A1_AmtR_devices[i4];
P3_PhlFDevice = P3_PhlF_devices[i5];
YFP_reporter_3Device = YFP_reporter_3_devices[i6];

Device circuit(
    E1_BetIDevice,
    H1_HlyIIRDevice,
    Q2_QacRDevice,
    A1_AmtRDevice,
    P3_PhlFDevice,
    YFP_reporter_3Device,
    Loc1,
    Loc2,
    Loc3
);


result = permute(circuit);

allResults = allResults + result;

}
}
}
}
}
